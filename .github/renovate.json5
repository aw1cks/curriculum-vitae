{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    automergeType: "pr",
    platformAutomerge: true,
    automergeStrategy: "rebase",
    extends: ["schedule:weekly"],
  },
  nix: {
    enabled: true,
  },
}
